{
  "name": "roamgate-server",
  "private": true,
  "version": "0.8.15",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "compile:pi": "bun build --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/assistant/pi-sidecar-main.ts --outfile roamgate-pi",
    "postcompile:pi": "bun run clean:bun-build",
    "clean:bun-build": "find . -maxdepth 1 -name '*.bun-build' -exec rm -rf {} +",
    "clean": "rm -rf public roamgate roamgate.exe roamgate-* herdr-gui herdr-gui-* && bun run clean:bun-build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.4.4",
    "undici": "8.12.3"
  }
}
