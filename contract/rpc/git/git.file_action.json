  },
  "reply": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "root": {
        "type": "string"
      },
      "workspace_id": {
        "type": "string"
      }
    },
    "required": ["action", "path", "root", "workspace_id"]
