        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "workspace_id": {
        "type": "string"
      },
      "mtime_ms": {
        "type": ["number", "string"],
        "description": "delete_untracked: the fingerprint the browser read (git.diff_summary), checked before deleting"
      },
      "size": {
        "type": ["number", "string"]
