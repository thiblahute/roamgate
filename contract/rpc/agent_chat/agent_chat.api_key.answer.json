{
  "method": "agent_chat.api_key.answer",
  "family": "agent_chat",
  "scope": "connection",
  "handler": "server/src/conversation/rpc.ts",
  "params": {
    "type": "object",
    "required": ["pane_id", "use"],
    "properties": {
      "pane_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "use": {
        "enum": ["api_key", "login"]
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": ["ok"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["ok", "reason"],
        "additionalProperties": false
      }
    ]
  },
  "status": "typed"
}
