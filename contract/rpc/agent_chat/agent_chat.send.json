{
  "method": "agent_chat.send",
  "family": "agent_chat",
  "scope": "connection",
  "handler": "server/src/index.ts",
  "params": {
    "type": "object",
    "required": ["pane_id"],
    "properties": {
      "pane_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "text": {
        "type": "string",
        "maxLength": 200000
      },
      "uuid": {
        "type": "string",
        "pattern": "^[\\w-]{1,100}$"
      },
      "images": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "status": {
        "enum": ["sent", "queued"]
      },
      "id": {
        "type": "string"
      }
    },
    "required": ["status", "id"],
    "additionalProperties": false
  },
  "status": "typed"
}
