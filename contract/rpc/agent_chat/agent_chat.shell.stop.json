{
  "method": "agent_chat.shell.stop",
  "family": "agent_chat",
  "scope": "connection",
  "handler": "server/src/conversation/rpc.ts",
  "params": {
    "type": "object",
    "required": ["pane_id", "id"],
    "properties": {
      "pane_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "id": {
        "type": "string",
        "pattern": "^[\\w-]{1,100}$"
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "stopped": {
        "type": "boolean"
      }
    },
    "required": ["stopped"],
    "additionalProperties": false
  },
  "status": "typed"
}
