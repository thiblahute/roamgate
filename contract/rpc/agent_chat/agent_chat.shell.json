{
  "method": "agent_chat.shell",
  "family": "agent_chat",
  "scope": "connection",
  "handler": "server/src/conversation/rpc.ts",
  "params": {
    "type": "object",
    "required": ["pane_id", "command"],
    "properties": {
      "pane_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "command": {
        "type": "string",
        "maxLength": 20000
      },
      "id": {
        "type": "string",
        "pattern": "^[\\w-]{1,100}$"
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "status": "typed"
}
