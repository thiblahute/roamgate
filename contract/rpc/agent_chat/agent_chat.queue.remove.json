{
  "method": "agent_chat.queue.remove",
  "family": "agent_chat",
  "scope": "connection",
  "handler": "server/src/conversation/rpc.ts",
  "params": {
    "type": "object",
    "required": ["pane_id", "id"],
    "properties": {
      "pane_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "id": {
        "type": "string",
        "pattern": "^[\\w-]{1,100}$"
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "removed": {
        "anyOf": [
          {
            "$ref": "../../schemas/shared/agentChat.schema.json#/$defs/AgentChatQueued"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": ["removed"],
    "additionalProperties": false
  },
  "status": "typed"
}
