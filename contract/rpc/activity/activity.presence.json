{
  "method": "activity.presence",
  "family": "activity",
  "scope": "connection",
  "handler": "server/src/index.ts",
  "params": {
    "type": "object",
    "required": ["client_id", "client_kind", "visible", "focused"],
    "properties": {
      "client_id": {
        "type": "string"
      },
      "client_kind": {
        "enum": ["desktop", "phone"]
      },
      "workspace_id": {
        "type": ["string", "null"]
      },
      "tab_id": {
        "type": ["string", "null"]
      },
      "pane_id": {
        "type": ["string", "null"]
      },
      "visible": {
        "type": "boolean"
      },
      "focused": {
        "type": "boolean"
      },
      "input_age_ms": {
        "type": ["number", "null"],
        "minimum": 0
      },
      "cause": {
        "type": ["string", "null"],
        "enum": [
          "user_input",
          "user_focus",
          "page_load",
          "follow_herdr",
          "app",
          null
        ]
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "$ref": "../../schemas/server.schema.json#/$defs/PresenceReply"
  },
  "status": "typed"
}
