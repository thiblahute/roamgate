{
  "method": "bridge.mr_reviews.feedback",
  "family": "bridge.mr_reviews",
  "scope": "bridge",
  "handler": "server/src/mr-reviews/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "verdict": {
        "enum": ["not_interested", "more_like_this", null]
      }
    },
    "required": ["key", "verdict"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      }
    },
    "required": ["ok"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
