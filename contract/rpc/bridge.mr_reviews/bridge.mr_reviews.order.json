{
  "method": "bridge.mr_reviews.order",
  "family": "bridge.mr_reviews",
  "scope": "bridge",
  "handler": "server/src/mr-reviews/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "op": {
        "enum": ["top", "bottom", "before", "after", "arrange", "undo"]
      },
      "keys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "target": {
        "type": "string"
      },
      "version": {
        "type": "integer"
      }
    },
    "required": ["op"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "ok": {
        "const": true
      },
      "changed": {
        "type": "boolean"
      },
      "version": {
        "type": "integer",
        "minimum": 0
      },
      "unknown": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "elsewhere": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["ok", "version"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
