{
  "method": "bridge.mr_reviews.agent.send",
  "family": "bridge.mr_reviews",
  "scope": "bridge",
  "handler": "server/src/mr-reviews/module.ts",
  "params": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "request_id": {
        "type": "string"
      },
      "when_busy": {
        "type": "string"
      }
    }
  },
  "reply": {
    "type": "object",
    "required": ["queued", "snapshot"],
    "properties": {
      "queued": {
        "type": "boolean"
      },
      "snapshot": {
        "$ref": "../../schemas/shared/mrReviews.schema.json#/$defs/MrAgentSnapshot"
      }
    },
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
