{
  "method": "bridge.mr_reviews.view",
  "family": "bridge.mr_reviews",
  "scope": "bridge",
  "handler": "server/src/mr-reviews/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "action": {
        "enum": ["save", "delete"]
      },
      "name": {
        "type": "string"
      },
      "query": {
        "type": "string"
      },
      "by": {
        "enum": ["user", "agent"]
      },
      "summary": {
        "type": "string"
      }
    },
    "required": ["action", "name"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "ok": {
        "const": true
      },
      "name": {
        "type": "string"
      },
      "changed": {
        "type": "boolean"
      },
      "version": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": ["ok", "name", "changed", "version"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
