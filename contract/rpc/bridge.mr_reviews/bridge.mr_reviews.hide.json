{
  "method": "bridge.mr_reviews.hide",
  "family": "bridge.mr_reviews",
  "scope": "bridge",
  "handler": "server/src/mr-reviews/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "by": {
        "enum": ["user", "agent"]
      },
      "summary": {
        "type": "string"
      }
    },
    "required": ["key"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "ok": {
        "const": true
      },
      "action": {
        "enum": ["hidden", "unpinned"]
      }
    },
    "required": ["ok", "action"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
