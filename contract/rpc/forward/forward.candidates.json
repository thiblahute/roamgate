{
  "method": "forward.candidates",
  "family": "forward",
  "scope": "connection",
  "handler": "server/src/bridge/forward-rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "direction": {
        "enum": ["local", "remote"]
      }
    }
  },
  "reply": {
    "type": "object",
    "required": ["candidates"],
    "properties": {
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["port"],
          "properties": {
            "port": {
              "type": "integer"
            },
            "process": {
              "type": "string"
            },
            "address": {
              "type": "string"
            }
          }
        }
      }
    },
    "additionalProperties": false
  },
  "status": "typed"
}
