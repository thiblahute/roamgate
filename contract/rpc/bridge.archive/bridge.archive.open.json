{
  "method": "bridge.archive.open",
  "family": "bridge.archive",
  "scope": "bridge",
  "handler": "server/src/index.ts",
  "params": {
    "type": "object",
    "required": ["key", "line"],
    "properties": {
      "key": {
        "type": "string",
        "maxLength": 1000
      },
      "line": {
        "type": "integer"
      },
      "raw": {
        "type": "boolean"
      },
      "context": {
        "type": "integer"
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "anyOf": [
      {
        "$ref": "../../schemas/shared/archiveSearch.schema.json#/$defs/OpenedSession"
      },
      {
        "type": "null"
      }
    ]
  },
  "status": "typed"
}
