{
  "method": "review.gitlab.open",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "url": {
        "type": "string"
      }
    },
    "required": ["session_id"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "mergeRequest": {
        "anyOf": [
          {
            "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewMergeRequestLink"
          },
          {
            "type": "null"
          }
        ]
      },
      "snapshot": {
        "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewSnapshot"
      }
    },
    "required": ["mergeRequest"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
