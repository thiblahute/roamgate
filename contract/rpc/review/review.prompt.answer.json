{
  "method": "review.prompt.answer",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "answer": {
        "enum": ["allow", "always", "deny", "dismiss"]
      },
      "answers": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "release": {
        "type": "boolean"
      }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "answered": {
        "type": "boolean"
      }
    },
    "required": ["answered"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
