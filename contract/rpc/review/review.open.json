{
  "method": "review.open",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/index.ts",
  "params": {
    "type": "object",
    "properties": {
      "workspace_id": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "target": {
        "type": "object"
      },
      "head": {
        "type": "string"
      },
      "file": {
        "type": "string"
      },
      "agent": {
        "type": "string"
      },
      "agent_pane": {
        "type": "string"
      }
    },
    "required": ["workspace_id"],
    "additionalProperties": false
  },
  "reply": {
    "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewSnapshot"
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
