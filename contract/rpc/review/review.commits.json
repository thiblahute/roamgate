{
  "method": "review.commits",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "workspace_id": {
        "type": "string"
      },
      "checkout": {
        "type": "string"
      },
      "target": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "commits": {
        "type": "array",
        "items": {
          "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewCommit"
        }
      }
    },
    "required": ["commits"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
