{
  "method": "review.restore",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "thread": {
        "type": "object"
      }
    },
    "required": ["session_id", "thread"],
    "additionalProperties": false
  },
  "reply": {
    "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewThread"
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
