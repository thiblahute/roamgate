{
  "method": "review.snapshots",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "snapshots": {
        "type": "array",
        "items": {
          "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewSnapshot"
        }
      },
      "missing": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["snapshots", "missing"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
