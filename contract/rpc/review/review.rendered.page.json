{
  "method": "review.rendered.page",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "page": {
        "type": "string"
      },
      "scripts": {
        "type": "boolean"
      },
      "svg": {
        "type": "string"
      },
      "color": {
        "type": "string"
      },
      "file": {
        "type": "string"
      },
      "target": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "src": {
        "type": "string"
      },
      "mode": {
        "type": "string"
      },
      "site": {
        "type": "string"
      }
    },
    "required": ["src", "mode"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
