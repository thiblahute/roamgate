{
  "method": "review.resolve",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "comment_id": {
        "type": "string"
      },
      "resolved": {
        "type": "boolean"
      },
      "held": {}
    },
    "required": ["session_id", "comment_id"],
    "additionalProperties": false
  },
  "reply": {
    "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewThread"
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
