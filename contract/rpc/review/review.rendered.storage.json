{
  "method": "review.rendered.storage",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "token": {
        "type": "string"
      },
      "write": {
        "type": "object",
        "properties": {
          "op": {
            "enum": ["set", "remove", "clear"]
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": ["op"]
      }
    },
    "required": ["token", "write"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "stored": {
        "type": "boolean"
      }
    },
    "required": ["stored"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
