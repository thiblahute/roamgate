{
  "method": "review.gitlab.find",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "local": {
        "type": "boolean"
      }
    },
    "required": ["session_id"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "mergeRequest": {
        "anyOf": [
          {
            "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewMergeRequestLink"
          },
          {
            "type": "null"
          }
        ]
      },
      "localReviews": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["mergeRequest"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
