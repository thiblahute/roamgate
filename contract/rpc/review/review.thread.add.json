{
  "method": "review.thread.add",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "anchor": {
        "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewAnchor"
      },
      "held": {
        "type": "integer"
      },
      "new_thread_id": {
        "type": "string"
      },
      "new_comment_id": {
        "type": "string"
      }
    },
    "required": ["session_id"],
    "additionalProperties": false
  },
  "reply": {
    "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewThread"
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
