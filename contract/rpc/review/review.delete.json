{
  "method": "review.delete",
  "family": "review",
  "scope": "connection",
  "handler": "server/src/review/rpc.ts",
  "params": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "comment_id": {
        "type": "string"
      }
    },
    "required": ["session_id", "comment_id"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "deleted": {
        "type": "string"
      },
      "thread": {
        "anyOf": [
          {
            "$ref": "../../schemas/shared/review.schema.json#/$defs/ReviewThread"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": ["deleted"],
    "additionalProperties": false
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
