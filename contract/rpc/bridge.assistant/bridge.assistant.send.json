{
  "method": "bridge.assistant.send",
  "family": "bridge.assistant",
  "scope": "bridge",
  "handler": "server/src/assistant/service.ts",
  "params": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "request_id": {
        "type": "string"
      },
      "mentions": {
        "type": "array",
        "items": {
          "$ref": "../../schemas/shared/assistant.schema.json#/$defs/AssistantMention"
        }
      },
      "when_busy": {
        "type": "string"
      },
      "images": {
        "type": "array"
      }
    }
  },
  "reply": {
    "$ref": "../../schemas/shared/assistant.schema.json#/$defs/AssistantSnapshot"
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
