{
  "method": "bridge.assistant.configure_model",
  "family": "bridge.assistant",
  "scope": "bridge",
  "handler": "server/src/assistant/service.ts",
  "params": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reasoning": {
        "type": "boolean"
      },
      "thinking_levels": {
        "type": "array"
      },
      "base_url": {
        "type": "string"
      },
      "api": {
        "type": "string"
      },
      "api_key": {
        "type": "string"
      },
      "credential_source": {
        "type": "string"
      }
    }
  },
  "reply": {
    "$ref": "../../schemas/shared/assistant.schema.json#/$defs/AssistantSnapshot"
  },
  "status": "typed",
  "error": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string"
      },
      "code": {
        "type": "string"
      }
    }
  }
}
