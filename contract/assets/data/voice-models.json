  "components": [
    {
      "id": "speech",
      "title": "Speech recognition",
      "description": "Turns what is said into text.",
      "optional": false
    },
    {
      "id": "reread",
      "title": "Second reading",
      "description": "Whisper hears again what Parakeet wrote in English while the conversation is in another language.",
      "optional": true,
      "requires": {
        "component": "speech",
        "options": [
          "parakeet"
        ]
      }
    },
    {
      "id": "tts",
      "title": "Reading voice",
      "description": "Reads the replies aloud. Qwen3-TTS reads with voices recorded in Voices below, Pocket TTS and Kokoro with their own.",
      "optional": false
    },
    {
      "id": "stock_voices",
      "title": "Stock voices",
      "description": "Qwen3-TTS CustomVoice: named voices (Ryan, Vivian...) to choose in Voices below.",
      "optional": true,
      "requires": {
        "component": "tts",
        "options": [
          "qwen3-tts-1.7b",
          "qwen3-tts-0.6b"
        ]
      }
    },
    {
      "id": "speaker",
      "title": "Who speaks",
      "description": "Tells voices apart, so the companion knows you from the people around you.",
      "optional": true
    },
    {
      "id": "turn",
      "title": "End of turn (voice)",
      "description": "A pause ends what you say only when your voice sounds finished.",
      "optional": true
    },
    {
      "id": "text_turn",
      "title": "End of turn (words)",
      "description": "Reads what was said at each pause: unfinished words keep the turn open.",
      "optional": true,
      "requires": {
        "component": "speech",
        "options": [
          "parakeet"
        ]
      }
    }
  ],
