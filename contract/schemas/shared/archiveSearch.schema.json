{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roamgate.dev/contract/schemas/shared/archiveSearch.schema.json",
  "x-generated-from": "shared/archiveSearch.ts",
  "$defs": {
    "OpenedMessage": {
      "type": "object",
      "properties": {
