      "additionalProperties": false,
      "description": "The archive search's wire shapes: what `roamgate archive search --json`, Ranger's tools and the search view (`bridge.archive.search`, `bridge.archive.open`) get."
    },
    "SearchResult": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "total": {
          "type": "number"
        },
        "hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchHit"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "ts": {
                "type": ["string", "null"]
