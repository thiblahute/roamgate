{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roamgate.dev/contract/schemas/shared/agentProfiles.schema.json",
  "x-generated-from": "shared/agentProfiles.ts",
  "$defs": {
    "AccountAuthState": {
      "type": "string",
      "enum": ["unknown", "signed_in", "signed_out", "needs_relogin"],
      "description": "Whether an account's sign-in is there, as far as the server can tell."
    },
    "AccountChain": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Account profiles' names, in order."
        },
        "auto_switch": {
          "type": "boolean"
        },
        "five_hour_line": {
          "type": "number",
          "description": "The 5-hour line (default 95)."
        },
        "weekly_line": {
          "type": "number",
          "description": "The weekly line, aggregate and per-model (default 98)."
        },
        "lines": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ChainLines"
          },
          "description": "Lines of their own, by account."
        },
        "preferred": {
          "type": "string",
          "description": "Taken first on its days."
        },
        "preferred_days": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "0 (Sunday) to 6; none: every day."
        },
        "last_resort": {
          "type": "string",
          "description": "Taken only when no other account can."
        },
        "walk": {
          "$ref": "#/$defs/ChainWalk"
        }
      },
      "required": [
        "accounts",
        "auto_switch",
        "five_hour_line",
        "weekly_line",
        "walk"
      ],
      "additionalProperties": false,
      "description": "The account chain: account profiles in order. The default profile moves along it when it crosses a line (with `auto_switch`), and a session stopped by a usage limit goes on with the next account."
    },
    "AgentProfile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/ProfileAgent",
          "description": "The agent driver."
        },
        "command": {
          "type": "string",
          "description": "The program; absent: the driver's own (`claude`)."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ProfileEnvValue"
          },
          "description": "Set for the agent; `{file}` values are read at start, never shown."
        },
        "unset": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Removed from the agent's environment (besides the implied ones)."
        },
        "account": {
          "$ref": "#/$defs/ProfileAccount",
          "description": "Set: an account profile, its own sign-in of the agent."
        }
      },
      "required": ["name", "agent"],
      "additionalProperties": false
    },
    "ChainLines": {
      "type": "object",
      "properties": {
        "five_hour": {
          "type": "number"
        },
        "weekly": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "description": "An account's own lines (percent used)."
    },
    "ChainWalk": {
      "type": "string",
      "enum": ["chain", "soonest_reset", "most_headroom"]
    },
    "ProfileAccount": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": ["id"],
      "additionalProperties": false,
      "description": "An account profile's sign-in: the directory `accounts/<agent>/<id>/`."
    },
    "ProfileAccountView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "dir": {
          "type": "string",
          "description": "The account's directory (`settings.profiles.get` only)."
        },
        "auth": {
          "$ref": "#/$defs/AccountAuthState",
          "description": "Its sign-in (`settings.profiles.get` only)."
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "ProfileAgent": {
      "type": "string",
      "enum": ["claude", "codex", "agy"]
    },
    "ProfileEnvValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": ["file"],
          "additionalProperties": false
        }
      ]
    },
    "ProfilesSettings": {
      "type": "object",
      "properties": {
        "list": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentProfile"
          },
          "description": "The user's profiles; the built-in Claude is added unless redefined."
        },
        "default": {
          "type": "string",
          "description": "Used for new sessions, headless runs and Roamgate's helpers."
        },
        "return_after_reset": {
          "type": "boolean",
          "description": "After a usage limit sent a session to another profile, go back to the default once the limit resets."
        },
        "chain": {
          "$ref": "#/$defs/AccountChain",
          "description": "The account chain, when set: where sessions go past a limit."
        }
      },
      "required": ["list", "default", "return_after_reset"],
      "additionalProperties": false
    },
    "ProfileView": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/ProfileAgent"
        },
        "command": {
          "type": "string"
        },
        "builtin": {
          "type": "boolean"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "unset": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "account": {
          "$ref": "#/$defs/ProfileAccountView",
          "description": "An account profile's id; the server adds its `dir` and `auth`."
        }
      },
      "required": ["name", "agent", "builtin", "env", "unset"],
      "additionalProperties": false,
      "description": "What a browser is shown of a profile: secret files by path only."
    },
    "UsageLimit": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "\"5-hour\", \"weekly\", \"session\", \"Opus\"...; \"usage\" when not said."
        },
        "resets": {
          "type": ["string", "null"],
          "description": "The message's own reset words (\"5:20pm (America/Santiago)\")."
        },
        "resets_at": {
          "type": ["number", "null"],
          "description": "When it resets, if the message says (epoch ms)."
        },
        "zone": {
          "type": "string",
          "description": "The time zone the message gave its reset in, if any."
        },
        "at": {
          "type": "number",
          "description": "When the agent reported it (the transcript record's time, epoch ms)."
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["kind", "resets", "resets_at", "message"],
      "additionalProperties": false,
      "description": "A usage limit an agent hit, from its message."
    }
  }
}
