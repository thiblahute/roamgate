{
  "description": "The claude start hook's installer on a host's Claude settings, as the Python installer (contract/assets/python/claude-start-hook-install.py, run on SSH hosts) does it and the server's own (crates/roamgate-agent-client/src/hook_install.rs, run on its machine) must: per case whether the Claude directory exists, settings.json before (null: none), the word printed, and settings.json after. Generated by running the Python installer; read by crates/roamgate-agent-client/tests/vectors.rs.",
  "cases": [
    {
      "name": "no Claude directory",
      "claude_dir": false,
      "settings": null,
      "outcome": "no-claude",
      "after": null
    },
    {
      "name": "no settings file",
      "claude_dir": true,
      "settings": null,
      "outcome": "installed",
      "after": "{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"matcher\": \"startup|resume\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.cache/roamgate/bin/roamgate-review claude-start\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ]\n  }\n}\n"
    },
    {
      "name": "an empty file",
      "claude_dir": true,
      "settings": "",
      "outcome": "installed",
      "after": "{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"matcher\": \"startup|resume\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.cache/roamgate/bin/roamgate-review claude-start\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ]\n  }\n}\n"
    },
    {
      "name": "blank",
      "claude_dir": true,
      "settings": "  \n",
      "outcome": "installed",
      "after": "{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"matcher\": \"startup|resume\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.cache/roamgate/bin/roamgate-review claude-start\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ]\n  }\n}\n"
    },
    {
      "name": "the user's settings and hooks",
      "claude_dir": true,
      "settings": "{\"model\": \"opus\", \"hooks\": {\"SessionStart\": [{\"matcher\": \"*\", \"hooks\": [{\"type\": \"command\", \"command\": \"my-hook\"}]}], \"Stop\": []}, \"env\": {\"A\": \"caf\\u00e9\"}, \"n\": 1.5, \"big\": 12345678901234}",
      "outcome": "installed",
      "after": "{\n  \"model\": \"opus\",\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"my-hook\"\n          }\n        ]\n      },\n      {\n        \"matcher\": \"startup|resume\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.cache/roamgate/bin/roamgate-review claude-start\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ],\n    \"Stop\": []\n  },\n  \"env\": {\n    \"A\": \"caf\\u00e9\"\n  },\n  \"n\": 1.5,\n  \"big\": 12345678901234\n}\n"
    },
    {
      "name": "already there",
      "claude_dir": true,
      "settings": "{\"hooks\": {\"SessionStart\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"/x/roamgate-review claude-start --v\"}]}]}}",
      "outcome": "present",
      "after": "{\"hooks\": {\"SessionStart\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"/x/roamgate-review claude-start --v\"}]}]}}"
    },
    {
      "name": "not JSON",
      "claude_dir": true,
      "settings": "{ // comment\n}",
      "outcome": "invalid",
      "after": "{ // comment\n}"
    },
    {
      "name": "not an object",
      "claude_dir": true,
      "settings": "[]",
      "outcome": "invalid",
      "after": "[]"
    },
    {
      "name": "hooks not an object",
      "claude_dir": true,
      "settings": "{\"hooks\": []}",
      "outcome": "invalid",
      "after": "{\"hooks\": []}"
    },
    {
      "name": "hooks null",
      "claude_dir": true,
      "settings": "{\"hooks\": null}",
      "outcome": "invalid",
      "after": "{\"hooks\": null}"
    },
    {
      "name": "SessionStart not a list",
      "claude_dir": true,
      "settings": "{\"hooks\": {\"SessionStart\": {}}}",
      "outcome": "invalid",
      "after": "{\"hooks\": {\"SessionStart\": {}}}"
    },
    {
      "name": "odd groups and hooks",
      "claude_dir": true,
      "settings": "{\"hooks\": {\"SessionStart\": [\"x\", {\"hooks\": null}, {\"hooks\": [1, {\"command\": null}, {\"command\": 5}]}]}}",
      "outcome": "installed",
      "after": "{\n  \"hooks\": {\n    \"SessionStart\": [\n      \"x\",\n      {\n        \"hooks\": null\n      },\n      {\n        \"hooks\": [\n          1,\n          {\n            \"command\": null\n          },\n          {\n            \"command\": 5\n          }\n        ]\n      },\n      {\n        \"matcher\": \"startup|resume\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.cache/roamgate/bin/roamgate-review claude-start\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ]\n  }\n}\n"
    },
    {
      "name": "pretty with unicode keys",
      "claude_dir": true,
      "settings": "{\n    \"\u00e9t\u00e9\": true,\n    \"list\": [1, 2, {\"a\": []}]\n}\n",
      "outcome": "installed",
      "after": "{\n  \"\\u00e9t\\u00e9\": true,\n  \"list\": [\n    1,\n    2,\n    {\n      \"a\": []\n    }\n  ],\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"matcher\": \"startup|resume\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.cache/roamgate/bin/roamgate-review claude-start\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ]\n  }\n}\n"
    }
  ]
}
