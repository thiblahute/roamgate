                "line": 1,
                "endLine": 2,
                "side": "old",
                "text": "a",
                "feedback": "{\"source\":\"diff\",\"kind\":\"unstaged\",\"path\":\"f\",\"side\":\"old\",\"line\":1,\"endLine\":2,\"endSide\":\"old\"}"
