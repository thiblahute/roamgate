{
  "description": "Anchors of the combined diff (combinedAnchor). Read by `bun test` in server/src/review/changes-anchors.test.ts.",
  "modules": {
    "patch": "server/src/review/patch.ts",
    "changes-anchors": "server/src/review/changes-anchors.ts"
