                    { "kind": "+", "old": null, "new": 1, "text": "top" },
                    { "kind": " ", "old": 1, "new": 2, "text": "a" },
                    { "kind": "-", "old": 2, "new": null, "text": "b" },
                    { "kind": "+", "old": null, "new": 3, "text": "B" },
                    { "kind": " ", "old": 3, "new": 4, "text": "c" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "fn": "changes-anchors.combinedAnchor",
          "args": [
            {
              "id": "t",
              "sessionId": "s",
              "kind": "discussion",
              "anchor": {
                "path": "f",
                "feedback": "{\"source\":\"diff\",\"kind\":\"staged\",\"path\":\"f\"}"
              },
              "comments": [],
              "resolved": false,
              "createdAt": "",
              "updatedAt": ""
