  "cases": [
    {
      "name": "common lines stay as context, the rest removed then added",
      "group": ["a change's lines"],
      "calls": [
        {
          "fn": "fileEdits.lineDiff",
          "args": ["a\nb\nc\n", "a\nB\nc\n"],
          "result": [" a", "-b", "+B", " c"]
