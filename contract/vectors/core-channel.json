    {
      "name": "a queued push is replaced by a newer one with its key, which goes last",
      "group": ["outbound queue"],
      "calls": [
        {
          "fn": "coreChannel.OutboundQueue",
          "new": true,
          "args": [],
          "result": {
            "$handle": 1
          }
        },
        {
          "on": 1,
          "method": "enqueue",
          "args": ["p1", "review"],
          "result": 1
        },
        {
          "on": 1,
          "method": "enqueue",
          "args": ["r1", null],
          "result": 2
        },
        {
          "on": 1,
          "method": "enqueue",
          "args": ["w1", "work"],
          "result": 3
        },
        {
          "on": 1,
          "method": "enqueue",
          "args": ["p2", "review"],
          "result": 3
        },
        {
          "on": 1,
          "method": "size",
          "args": [],
          "result": 3
        },
        {
          "on": 1,
          "method": "take",
          "args": [],
          "result": "r1"
        },
        {
          "on": 1,
          "method": "take",
          "args": [],
          "result": "w1"
        },
        {
          "on": 1,
          "method": "enqueue",
          "args": ["w2", "work"],
          "result": 2
        },
        {
          "on": 1,
          "method": "take",
          "args": [],
          "result": "p2"
        },
        {
          "on": 1,
          "method": "take",
          "args": [],
          "result": "w2"
        },
        {
          "on": 1,
          "method": "take",
          "args": [],
          "result": null
        },
        {
          "on": 1,
          "method": "size",
          "args": [],
          "result": 0
        }
      ]
    },
    {
      "name": "a push already taken is never replaced",
      "group": ["outbound queue"],
      "calls": [
        {
          "fn": "coreChannel.OutboundQueue",
          "new": true,
          "args": [],
          "result": {
            "$handle": 1
          }
        },
        {
          "on": 1,
          "method": "enqueue",
          "args": ["p1", "review"],
          "result": 1
        },
        {
          "on": 1,
          "method": "take",
          "args": [],
          "result": "p1"
        },
        {
          "on": 1,
          "method": "enqueue",
          "args": ["p2", "review"],
          "result": 1
        },
        {
          "on": 1,
          "method": "enqueue",
          "args": ["m1", null],
          "result": 2
        },
        {
          "on": 1,
          "method": "enqueue",
          "args": ["m2", null],
          "result": 3
        },
        {
          "on": 1,
          "method": "take",
          "args": [],
          "result": "p2"
        },
        {
          "on": 1,
          "method": "take",
          "args": [],
          "result": "m1"
        },
        {
          "on": 1,
          "method": "take",
          "args": [],
          "result": "m2"
        }
      ]
    }
