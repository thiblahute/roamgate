{
  "description": "The internal channel between the front and the core (contract/wire/core-channel.md): its frames, the family of a method or path, and the outbound queue's coalescing. Read by roamgate-channel's tests.",
  "modules": {
    "coreChannel": "crates/roamgate-channel/src/protocol.rs"
  },
  "cases": [
    {
      "name": "a JSON message is one JSON frame, compact",
      "group": ["frames"],
      "calls": [
        {
          "fn": "coreChannel.encodeMessage",
          "args": [
            {
              "t": "ping",
              "n": 1
            }
          ],
          "result": {
            "$bytes": "13000000007b2274223a2270696e67222c226e223a317d"
          }
        },
        {
          "fn": "coreChannel.encodeMessage",
          "args": [
            {
              "t": "reply",
              "id": 7,
              "result": {
                "text": "été"
              }
            }
          ],
          "result": {
            "$bytes": "2f000000007b2274223a227265706c79222c226964223a372c22726573756c74223a7b2274657874223a22c3a974c3a9227d7d"
          }
        }
      ]
    },
    {
      "name": "a body chunk is its stream id, its flags, then its bytes",
      "group": ["frames"],
      "calls": [
        {
          "fn": "coreChannel.encodeBody",
          "args": [
            7,
            0,
            {
              "$bytes": "68656c6c6f"
            }
          ],
          "result": {
            "$bytes": "0b00000002070000000068656c6c6f"
          }
        },
        {
          "fn": "coreChannel.encodeBody",
          "args": [
            4294967295,
            3,
            {
              "$bytes": ""
            }
          ],
          "result": {
            "$bytes": "0600000002ffffffff03"
          }
        },
        {
          "fn": "coreChannel.decodeBody",
          "args": [
            {
              "$bytes": "0900000001656e64"
            }
          ],
          "result": {
            "stream": 9,
            "flags": 1,
            "bytes": {
              "$bytes": "656e64"
            }
          }
        },
        {
          "fn": "coreChannel.decodeBody",
          "args": [
            {
              "$bytes": "0900"
            }
          ],
          "result": null
        }
      ]
    },
